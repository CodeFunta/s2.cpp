+bool ggml_metal_can_fuse_rope_cpy(const ggml_cgraph * gf, int first, int second) {
+    const auto * rope = gf->nodes[first];
+    const auto * dst = gf->nodes[second];
+    if (rope->op != GGML_OP_ROPE || dst->op != GGML_OP_CPY) return false;
+    const int indices[] = {first, second};
