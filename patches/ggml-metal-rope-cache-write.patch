+        dst->src[0] != rope || !ggml_is_contiguous(dst) ||
+        !ggml_can_fuse_ext(gf, indices, ops, 2)) return false;
+    const auto pd = reinterpret_cast<uintptr_t>(dst->data);
+    for (const auto * src : rope->src) {
+        if (!src) continue;
+        const auto ps = reinterpret_cast<uintptr_t>(src->data);
+        if (ps <= pd ? pd - ps < ggml_nbytes(src) : ps - pd < ggml_nbytes(dst)) return false;
+    }
+    return true;
