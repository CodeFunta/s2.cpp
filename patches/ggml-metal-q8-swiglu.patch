+[[host_name("kernel_mul_mv_q8_0_f32_swiglu")]]
+kernel void kernel_mul_mv_q8_0_f32_swiglu(
+        constant ggml_metal_kargs_mul_mv & args,
+        device const char * src0_gate,
+        device const char * src1,
+        device       char * dst,
+        device const char * src0_up,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    constexpr short NR0 = N_R0_Q8_0_SWIGLU;
+    constexpr short NW = N_SIMDWIDTH;
+    constexpr short NQ = 8;
+    const short NSG = FC_mul_mv_nsg;
+    const int nb = args.ne00/QK8_0;
+    const int r0 = tgpig.x*NR0;
+
+    device const float * y = (device const float *) src1;
+
+    device const block_q8_0 * gate[NR0];
+    device const block_q8_0 * up[NR0];
+    FOR_UNROLL (short row = 0; row < NR0; ++row) {
+        gate[row] = (device const block_q8_0 *) ((device char *) src0_gate + (r0 + row)*args.nb01);
+        up[row] = (device const block_q8_0 *) ((device char *) src0_up + (r0 + row)*args.nb01);
+    }
+
+    float gate_sumf[NR0] = { 0.f };
+    float up_sumf[NR0] = { 0.f };
+
+    const short il = tiisg%(NW/NQ);
+    const int ib0 = sgitg*NQ + tiisg/(NW/NQ);
+    float yl[NQ];
+    device const float * yb = y + ib0*QK8_0 + il*NQ;
+
+    for (int ib = ib0; ib < nb; ib += NSG*NQ) {
+        FOR_UNROLL (short i = 0; i < NQ; ++i) {
+            yl[i] = yb[i];
+        }
+
+        FOR_UNROLL (short row = 0; row < NR0; ++row) {
+            device const int8_t * gate_qs = gate[row][ib].qs + il*NQ;
+            float gate_sumq = 0.f;
+            FOR_UNROLL (short i = 0; i < NQ; ++i) {
+                gate_sumq += gate_qs[i] * yl[i];
+            }
+            gate_sumf[row] += gate_sumq*gate[row][ib].d;
+
+            device const int8_t * up_qs = up[row][ib].qs + il*NQ;
+            float up_sumq = 0.f;
+            FOR_UNROLL (short i = 0; i < NQ; ++i) {
+                up_sumq += up_qs[i] * yl[i];
+            }
+            up_sumf[row] += up_sumq*up[row][ib].d;
+        }
+
+        yb += NSG*NQ*QK8_0;
+    }
+
+    threadgroup float * gate_shmem = (threadgroup float *) shmem;
+    threadgroup float * up_shmem = gate_shmem + NR0*NW;
+    for (short row = 0; row < NR0; ++row) {
+        if (sgitg == 0) {
+            gate_shmem[NW*row + tiisg] = 0.0f;
+            up_shmem[NW*row + tiisg] = 0.0f;
+        }
+        gate_sumf[row] = simd_sum(gate_sumf[row]);
+        up_sumf[row] = simd_sum(up_sumf[row]);
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (short row = 0; row < NR0; ++row) {
+        if (tiisg == 0) {
+            gate_shmem[NW*row + sgitg] = gate_sumf[row];
+            up_shmem[NW*row + sgitg] = up_sumf[row];
+        }
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    device float * dst_f32 = (device float *) dst;
+    for (short row = 0; row < NR0 && r0 + row < args.ne01; ++row) {
+        const float gate = simd_sum(gate_shmem[NW*row + tiisg]);
+        const float up = simd_sum(up_shmem[NW*row + tiisg]);
+        if (tiisg == 0 && sgitg == 0) {
+            const float silu = gate/(1.0f+exp(-gate));
+            dst_f32[r0 + row] = silu*up;
+        }
+    }
+}
