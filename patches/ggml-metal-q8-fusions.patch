+    if (AddResidual) {
+        device const float * residual_f32 = (device const float *) residual;
+        helper_mv_reduce_add_and_write<NR0>(dst_f32, residual_f32, sumf, r0, args.ne01, tiisg, sgitg, shmem);
+    } else {
+        helper_mv_reduce_and_write<NR0>(dst_f32, sumf, r0, args.ne01, tiisg, sgitg, shmem);
+    }
+}
